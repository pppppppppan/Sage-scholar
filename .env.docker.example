# Copy to .env.docker; this file is for containers only. Keep local .env unchanged.
LLM_MODEL_ID=deepseek-v4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Other providers: copy the relevant variables from .env.example.

# Host Ollama (Docker Desktop). Must be reachable beyond host loopback.
ROUTER_BASE_URL=http://host.docker.internal:11434
ROUTER_ALLOWED_HOSTS=host.docker.internal,ollama
ROUTER_MODEL=qwen3.5:2b
ROUTER_TIMEOUT=60
OLLAMA_WAIT_SECONDS=60
# Set false only for maintenance without a Router; queries will not work then.
OLLAMA_CHECK_ON_START=true

EMBEDDING_PROVIDER=local
EMBEDDING_LOCAL_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_LOCAL_ONLY=true
RAG_CHUNK_TOKENS=480
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
RERANKER_LOCAL_ONLY=true
RERANKER_FALLBACK=rrf
FAISS_NUM_THREADS=1
OMP_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false

# Optional; model weights are NEVER downloaded during docker build.
# To enable, build with SAGE_DOCKER_VISUAL=true; see docs/deployment/docker.md.
PDF_VISUAL_ENABLED=false
PDF_VISUAL_PARSER=page
VISUAL_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B
VISUAL_EMBEDDING_REVISION=main
VISUAL_EMBEDDING_DEVICE=cpu
VISUAL_EMBEDDING_LOCAL_ONLY=true
VISION_MODEL_ID=deepseek-flash
VISION_MAX_IMAGES=3
VISION_TOKENS_PER_IMAGE=1024
VISION_RUN_IMAGE_TOKENS=60000
# HF_TOKEN=  # Only if the selected model/repository needs authentication.

TAVILY_API_KEY=
UNPAYWALL_EMAIL=
MCP_CONNECT_TIMEOUT=15
# Container MCP processes inherit these; the proxy must listen on a reachable host interface.
# http_proxy=http://host.docker.internal:7897
# https_proxy=http://host.docker.internal:7897
# HTTP_PROXY=http://host.docker.internal:7897
# HTTPS_PROXY=http://host.docker.internal:7897

OBSERVABILITY_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OBSERVABILITY_MODEL_PRICES_JSON={}
