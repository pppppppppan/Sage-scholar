# ===== LLM (choose one provider) =====
# Model name determines which provider is used (prefix-based auto-detection)
LLM_MODEL_ID="deepseek-v4-flash"

# DeepSeek (default) — https://platform.deepseek.com
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Zhipu GLM — https://open.bigmodel.cn
# GLM_API_KEY="your-glm-api-key"
# GLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4/"

# Google Gemini — https://aistudio.google.com/apikey
# GOOGLE_API_KEY="your-google-api-key"
# GOOGLE_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"

# OpenAI — https://platform.openai.com
# OPENAI_API_KEY="your-openai-api-key"

# Anthropic Claude — https://console.anthropic.com
# ANTHROPIC_API_KEY="your-anthropic-api-key"

# Alibaba Qwen — https://dashscope.console.aliyun.com
# QWEN_API_KEY="your-qwen-api-key"
# QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# ===== Embedding (local by default, no inference API fee) =====
EMBEDDING_PROVIDER="local"
EMBEDDING_LOCAL_MODEL="intfloat/multilingual-e5-small"
EMBEDDING_DEVICE="cpu"
EMBEDDING_BATCH_SIZE=16
# Token-bound structured chunks; local model tokenizer includes prefixes/special tokens.
RAG_CHUNK_TOKENS=480
# Remote embedding input limit; used with conservative byte counting.
EMBEDDING_MAX_INPUT_TOKENS=512
# EMBEDDING_LOCAL_ONLY=true  # Use only previously downloaded model files.
# For cloud embeddings set EMBEDDING_PROVIDER="api" and configure below.
# Optional independent embedding credential; falls back to GLM_API_KEY.
EMBEDDING_API_KEY=""
EMBEDDING_MODEL_ID="embedding-3"
EMBEDDING_BASE_URL="https://open.bigmodel.cn/api/paas/v4/"

# ===== Search (optional; configure at least one for public-web research) =====
TAVILY_API_KEY=""

# MCP startup deadline in seconds; process cleanup may add a few seconds.
MCP_CONNECT_TIMEOUT=12
MCP_RETRY_BASE_SECONDS=5
MCP_RETRY_MAX_SECONDS=300

# Local semantic routing via Ollama (independent of the cloud answering model).
# Start Ollama, then: ollama pull qwen3.5:2b
ROUTER_BASE_URL="http://127.0.0.1:11434"
ROUTER_MODEL="qwen3.5:2b"
ROUTER_TIMEOUT=60
ROUTER_CONFIDENCE_THRESHOLD=0.65

# ===== Optional =====
# REVIEW_MODEL_ID="qwen3.7-plus"  # Cross-model review: use a different LLM for quality review
# GITHUB_TOKEN="your-github-token"
# HF_TOKEN="your-hf-token"
# http_proxy="http://127.0.0.1:7897"
# https_proxy="http://127.0.0.1:7897"


# ===== Agent output limits (tokens; caps, not target length) =====
RESEARCHER_MAX_OUTPUT_TOKENS=4096
RESEARCH_NOTE_MAX_OUTPUT_TOKENS=4096
RESEARCH_NOTE_EXTENDED_OUTPUT_TOKENS=6144
WRITER_MAX_OUTPUT_TOKENS=16384
SAGE_DEEP_RESEARCH_MAX_STEPS=8
# Keep total Run cost controls; these differ from per-call context size.
SAGE_DEEP_RESEARCH_MAX_TOTAL_TOKENS=600000
SAGE_DEEP_RESEARCH_REPORT_RESERVE_TOKENS=150000

# ===== Context allocation (input + reserved output) =====
CONTEXT_MAX_TOKENS=30000
CONTEXT_SUPERVISOR_TOKENS=20000
CONTEXT_RESEARCHER_TOKENS=30000
CONTEXT_REVIEW_TOKENS=48000
CONTEXT_WRITER_TOKENS=64000
CONTEXT_RECENT_TURNS=6
CONTEXT_HISTORY_TOKENS=6000
CONTEXT_REPORT_THRESHOLD=2000
# Override only after checking the actual model/provider, especially custom gateways.
# LLM_CONTEXT_WINDOW=65536
# LLM_MAX_OUTPUT_TOKENS=16384

# ===== Optional PDF image RAG (text index is unchanged) =====
PDF_VISUAL_ENABLED=true
# docling: layout crops + pages; page: whole pages without layout/OCR.
PDF_VISUAL_PARSER=docling
PDF_VISUAL_MAX_PAGES=200
PDF_VISUAL_MAX_SIDE=1600
VISUAL_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B
# Prefer a pinned Hugging Face commit; changing it requires rebuilding.
VISUAL_EMBEDDING_REVISION=main
VISUAL_EMBEDDING_DEVICE=cpu
VISUAL_EMBEDDING_LOCAL_ONLY=true
# Vision-capable endpoint; reuses DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL.
VISION_MODEL_ID=deepseek-flash
VISION_MAX_IMAGES=3
# Conservative estimate, NOT the provider's exact image billing formula.
VISION_TOKENS_PER_IMAGE=1024
VISION_RUN_IMAGE_TOKENS=60000

# Persistent RAG: exact Flat for small libraries, HNSW above this chunk count.
RAG_HNSW_THRESHOLD=2048
FAISS_NUM_THREADS=1

# CrossEncoder: lazy/shared multilingual reranker.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Evaluation baseline: cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
RERANKER_LOCAL_ONLY=false
RERANKER_FALLBACK=rrf
RERANKER_CACHE_SIZE=2048

# A/B only: self-reported confidence is not a calibrated probability.
ROUTER_CONFIDENCE_GATE=false

# Optional metadata-only OTel export to Langfuse. No prompt/source/image bodies.
# Install: python -m pip install -r requirements-observability.txt
OBSERVABILITY_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OBSERVABILITY_QUEUE_SIZE=512
OBSERVABILITY_BATCH_SIZE=64
OBSERVABILITY_DELAY_MS=2000
OBSERVABILITY_TIMEOUT_SECONDS=3
# Exact model IDs -> USD per million tokens; empty means unknown locally.
# Each entry requires input/output; optional cache_read/cache_write rates.
OBSERVABILITY_MODEL_PRICES_JSON={}
